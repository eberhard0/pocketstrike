[Unit]
Description=PocketStrike image server (token-guarded front for ComfyUI)
After=network-online.target comfyui.service
Wants=comfyui.service

[Service]
User=eberhard
WorkingDirectory=/home/eberhard/pocketstrike/pc
EnvironmentFile=/home/eberhard/.config/pocketstrike-imagegen.env
ExecStart=/home/eberhard/pocketstrike/pc/.venv/bin/python imagegen_server.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
